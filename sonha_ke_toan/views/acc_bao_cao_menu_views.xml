<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_acc_bao_cao_menu_tree" model="ir.ui.view">
        <field name="name">acc.bao.cao.menu.tree</field>
        <field name="model">acc.bao.cao.menu</field>
        <field name="arch" type="xml">
            <tree string="Cấu hình menu báo cáo">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="parent_id"/>
                <field name="report_id"/>
                <field name="report_type"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_acc_bao_cao_menu_form" model="ir.ui.view">
        <field name="name">acc.bao.cao.menu.form</field>
        <field name="model">acc.bao.cao.menu</field>
        <field name="arch" type="xml">
            <form string="Cấu hình menu báo cáo">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="parent_id"/>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="report_id"/>
                            <field name="report_type"/>
                            <field name="menu_id" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Menu con">
                            <field name="child_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="report_id"/>
                                    <field name="report_type"/>
                                    <field name="active"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="acc_bao_cao_menu_action" model="ir.actions.act_window">
        <field name="name">Cấu hình menu báo cáo</field>
        <field name="res_model">acc.bao.cao.menu</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
