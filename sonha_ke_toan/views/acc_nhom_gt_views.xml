<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_acc_nhom_gt_tree" model="ir.ui.view">
        <field name="name">acc.nhom.gt.tree</field>
        <field name="model">acc.nhom.gt</field>
        <field name="arch" type="xml">
            <tree string="Nhóm GT" editable="bottom">
                <field name="oke" optional="show"/>
                <field name="ma" optional="show"/>
                <field name="ten" optional="show"/>
                <field name="dk" optional="show"/>
                <field name="fun_truoc" optional="show"/>
                <field name="fun_sau" optional="show"/>
                <field name="tinh_gv" optional="show"/>
                <field name="create_uid" string="Người tạo" optional="hide"/>
                <field name="write_uid" string="Người sửa" optional="hide"/>
                <field name="create_date" string="Ngày tạo" optional="hide"/>
                <field name="write_date" string="Ngày sửa" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="acc_nhom_gt_action" model="ir.actions.act_window">
        <field name="name">Nhóm GT</field>
        <field name="res_model">acc.nhom.gt</field>
        <field name="view_mode">tree</field>
    </record>

</odoo>