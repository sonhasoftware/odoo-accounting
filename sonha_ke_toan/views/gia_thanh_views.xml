<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_gia_thanh_tree" model="ir.ui.view">
        <field name="name">gia.thanh.tree</field>
        <field name="model">gia.thanh</field>
        <field name="arch" type="xml">
            <tree string="Giá thành">
                <field name="nhom"/>
                <field name="thang"/>
                <field name="nam"/>
                <field name="tai_khoan"/>
                <field name="dg_theo_tien"/>
            </tree>
        </field>
    </record>

    <record id="view_gia_thanh_form" model="ir.ui.view">
        <field name="name">gia.thanh.form</field>
        <field name="model">gia.thanh</field>
        <field name="arch" type="xml">
            <form string="Giá thành">
                <sheet>
                    <group>
                        <group>
                            <field name="nhom"/>
                            <field name="thang"/>
                            <field name="nam"/>
                        </group>
                        <group>
                            <field name="tai_khoan"/>
                            <field name="tk_auto"/>
                            <button string="Xử lý" type="object" name="action_xu_ly" class="btn-primary"/>
                            <button string="Hủy" class="btn-secondary" special="cancel"/>
                        </group>
                    </group>

                    <separator/>
                    <group>
                        <field name="dg_theo_tien"/>
                    </group>

                    <group col="2">
                        <group string="KC chi tiết theo">
                            <field name="kc_bo_phan"/>
                            <field name="kc_vu_viec"/>
                            <field name="kc_khach_hang"/>
                            <field name="kc_tscd"/>
                            <field name="kc_khoan_muc"/>
                            <field name="kc_phan_xuong"/>
                            <field name="kc_dtcp_tp"/>
                            <field name="kc_vlsphh"/>
                            <field name="kc_kho"/>
                        </group>
                        <group string="Phân bổ theo" col="4">
                            <group colspan="2">
                                <field name="pb_bo_phan"/>
                                <field name="pb_vu_viec"/>
                                <field name="pb_khach_hang"/>
                                <field name="pb_tscd"/>
                                <field name="pb_khoan_muc"/>
                                <field name="pb_phan_xuong"/>
                                <field name="pb_dtcp_tp"/>
                                <field name="pb_vlsphh"/>
                                <field name="pb_kho"/>
                            </group>
                            <group string="Tiêu thức phân bổ" colspan="2">
                                <field name="tieu_thuc_so_luong"/>
                                <field name="tieu_thuc_tien"/>
                            </group>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="gia_thanh_action" model="ir.actions.act_window">
        <field name="name">Giá thành</field>
        <field name="res_model">gia.thanh</field>
        <field name="view_mode">tree,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('view_gia_thanh_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_gia_thanh_form')})]"/>
    </record>
</odoo>
